# DevLog Environment Configuration

PORT=3000

# JSON Web Token Secret
JWT_SECRET=devlog-super-secret-jwt-key-2026

# Choose MongoDB (Mongoose) or Supabase:
# --------------------------------------------------
# MongoDB URI (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://username:password@cluster.mongodb.net/blogapp
# Example: mongodb://localhost:27017/blogapp
MONGODB_URI=

# Supabase Credentials (Optional alternative)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
